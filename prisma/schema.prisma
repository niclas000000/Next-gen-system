generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // admin, manager, user
  groups    String[] // Group IDs
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        Document[]        @relation("DocumentAuthor")
  processesOwned   Process[]         @relation("ProcessOwner")
  processesCreated Process[]         @relation("ProcessCreator")
  savedViews       SavedView[]
  documentVersions DocumentVersion[] @relation("VersionAuthor")
  readReceipts     ReadReceipt[]     @relation("ReadReceiptUser")
  notifications    Notification[]
  caseTypes        CaseType[]        @relation("CaseTypeCreator")
  cases            Case[]            @relation("CaseCreator")
  caseEvents       CaseEvent[]       @relation("CaseEventActor")
  caseComments     CaseComment[]     @relation("CaseCommentAuthor")
  caseAttachments  CaseAttachment[]  @relation("CaseAttachmentUploader")
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  members     String[] // User IDs
  createdAt   DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  tags        String[]
  content     String? // Rich text / markdown
  fileUrl     String? // Optional file attachment
  fileName    String?
  fileSize    Int?
  mimeType    String?
  status      String   @default("draft") // draft, pending, published, archived
  version     String   @default("0.1")

  // Document type & metadata
  documentTypeId      String?
  documentType        DocumentType? @relation(fields: [documentTypeId], references: [id])
  properties          Json          @default("{}") // Type-specific metadata values
  roles               Json          @default("{}") // { authorId, reviewerIds, approverIds, ownerId }
  approvalAssignments Json? // { [phaseIndex]: userId[] } captured at submit, consumed as phases advance
  changeDescription   String?
  validFrom           DateTime?
  validTo             DateTime?
  requireReadReceipt  Boolean       @default(false)

  createdBy String
  author    User    @relation("DocumentAuthor", fields: [createdBy], references: [id])
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processes    ProcessDocument[]
  approvals    DocumentApproval[]
  versions     DocumentVersion[]
  readReceipts ReadReceipt[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RegistryItem {
  id            String   @id @default(cuid())
  type          String // "category" | "tag"
  name          String
  color         String?
  description   String?
  scope         String   @default("all") // "document" | "workflow" | "process" | "all"
  isProcessRoot Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([type, name])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters   Json     @default("{}")
  createdAt DateTime @default(now())
}

model Process {
  id          String            @id @default(cuid())
  name        String
  description String?
  purpose     String?
  scope       String?
  parentId    String?
  parent      Process?          @relation("ProcessTree", fields: [parentId], references: [id])
  children    Process[]         @relation("ProcessTree")
  status      String            @default("draft") // draft | active | archived
  ownerId     String?
  owner       User?             @relation("ProcessOwner", fields: [ownerId], references: [id])
  category    String?
  tags        String[]
  nodes       Json              @default("[]")
  edges       Json              @default("[]")
  kpis        Json              @default("[]")
  documents   ProcessDocument[]
  caseTypes   ProcessCaseType[]
  createdBy   String
  creator     User              @relation("ProcessCreator", fields: [createdBy], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProcessDocument {
  processId  String
  documentId String
  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([processId, documentId])
}

model DocumentType {
  id                 String        @id @default(cuid())
  name               String
  prefix             String        @unique
  format             String        @default("richtext") // richtext | file
  propertyPackage    Json          @default("[]") // FormField[] — reuses form-builder field schema
  approvalFlowId     String?
  approvalFlow       ApprovalFlow? @relation(fields: [approvalFlowId], references: [id])
  requireReadReceipt Boolean       @default(false)
  requireChangeDesc  Boolean       @default(true)
  documents          Document[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ApprovalFlow {
  id            String         @id @default(cuid())
  name          String
  phases        Json           @default("[]") // [{ id, name, role, rule: 'any'|'all', deadlineDays, order }]
  documentTypes DocumentType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DocumentApproval {
  id          String    @id @default(cuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  phase       String // phase name from the flow
  status      String    @default("pending") // pending | approved | rejected
  assignedTo  String[] // user IDs
  responses   Json      @default("[]") // [{ userId, decision, comment, at }]
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    String // "0.1", "1.0", "1.1", "2.0"
  content    String? // snapshot of rich text content
  properties Json     @default("{}") // snapshot of type-specific metadata
  changeDesc String
  createdBy  String
  author     User     @relation("VersionAuthor", fields: [createdBy], references: [id])
  createdAt  DateTime @default(now())
}

model ReadReceipt {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ReadReceiptUser", fields: [userId], references: [id])
  readAt     DateTime @default(now())

  @@unique([documentId, userId])
}

model ViewFolder {
  id        String       @id @default(cuid())
  name      String
  parentId  String?
  parent    ViewFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  ViewFolder[] @relation("FolderTree")
  order     Int          @default(0)
  filter    Json         @default("{}") // { typeIds: [], status: [], tags: [] }
  createdAt DateTime     @default(now())
}

model LookupTable {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  scope       String        @default("all") // all | document | workflow | process
  values      LookupValue[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model LookupValue {
  id       String      @id @default(cuid())
  tableId  String
  table    LookupTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  label    String
  value    String
  color    String?
  order    Int         @default(0)
  parentId String? // optional one-level grouping
  active   Boolean     @default(true)

  @@unique([tableId, value])
}

model ProcessRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // step_assigned, step_due, instance_completed
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemView {
  id        String   @id @default(cuid())
  name      String
  section   String // 'cases' | 'documents'
  icon      String   @default("List")
  filters   Json     @default("{}")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase-based case management (CANEA ONE model). Config JSON = CaseTypeConfig
// in lib/case-config/schema.ts.
// ---------------------------------------------------------------------------

model CaseType {
  id           String            @id @default(cuid())
  name         String
  prefix       String            @unique
  status       String            @default("draft") // draft | published | archived
  draft        Json // CaseTypeConfig being edited; publishing snapshots it into a CaseTypeVersion
  // Who holds group roles in this environment: { [roleId]: { userIds: string[], groupIds: string[] } }.
  // Kept outside the config so the config stays portable between environments.
  roleBindings Json              @default("{}")
  nextNumber   Int               @default(1)
  createdBy    String
  creator      User              @relation("CaseTypeCreator", fields: [createdBy], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  versions     CaseTypeVersion[]
  cases        Case[]
  processes    ProcessCaseType[]
}

// Immutable snapshot; running cases keep the version they were started on.
model CaseTypeVersion {
  id          String   @id @default(cuid())
  caseTypeId  String
  caseType    CaseType @relation(fields: [caseTypeId], references: [id], onDelete: Cascade)
  version     Int
  config      Json
  publishedBy String
  publishedAt DateTime @default(now())
  cases       Case[]

  @@unique([caseTypeId, version])
}

model Case {
  id             String           @id @default(cuid())
  number         String           @unique // prefix + running number, e.g. DEV12
  title          String
  caseTypeId     String
  caseType       CaseType         @relation(fields: [caseTypeId], references: [id])
  versionId      String
  version        CaseTypeVersion  @relation(fields: [versionId], references: [id])
  // Sub case: created from a sub case field on the parent case
  parentId       String?
  parent         Case?            @relation("SubCases", fields: [parentId], references: [id])
  parentFieldId  String?
  subCases       Case[]           @relation("SubCases")
  phaseId        String
  phaseEnteredAt DateTime         @default(now())
  phaseDueAt     DateTime? // from the phase's deadlineDays/Hours
  status         String           @default("open") // open | closed | preClosed | cancelled
  values         Json             @default("{}") // { [fieldId]: value }
  roles          Json             @default("{}") // { [roleId]: userId[] }
  revision       Int              @default(0) // optimistic locking: bumped on every write
  createdBy      String
  creator        User             @relation("CaseCreator", fields: [createdBy], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  closedAt       DateTime?
  events         CaseEvent[]
  comments       CaseComment[]
  attachments    CaseAttachment[]

  @@index([parentId])
  @@index([caseTypeId, status])
}

model CaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String // created | saved | forward | backward | preEnd | roleAssigned | signed | cancelled
  fromPhaseId String?
  toPhaseId   String?
  actorId     String
  actor       User     @relation("CaseEventActor", fields: [actorId], references: [id])
  data        Json     @default("{}") // changed values, signature meaning, message …
  at          DateTime @default(now())

  @@index([caseId, at])
}

model CaseComment {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  phaseId   String
  body      String
  authorId  String
  author    User     @relation("CaseCommentAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

// Files are stored on disk under uploads/<caseId>/<id>; the attachments field value lists the ids.
model CaseAttachment {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fieldId    String?
  fileName   String
  mimeType   String
  size       Int
  uploadedBy String
  uploader   User     @relation("CaseAttachmentUploader", fields: [uploadedBy], references: [id])
  uploadedAt DateTime @default(now())
}

model ProcessCaseType {
  processId  String
  caseTypeId String
  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  caseType   CaseType @relation(fields: [caseTypeId], references: [id], onDelete: Cascade)

  @@id([processId, caseTypeId])
}
